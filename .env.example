# ==============================================================================
# StockFlow - Environment Configuration (.env)
# Complies with 12-Factor App methodology
# ==============================================================================

# Application Environment (development | production)
ENV=production

# Isolated Host Port Bindings (Bound to 127.0.0.1)
FRONTEND_PORT=9520
BACKEND_PORT=9521
DB_PORT=9522

# PostgreSQL Database Credentials
DB_USER=postgres
DB_PASSWORD=ChangeThisToStrongSecurePasswordInProduction!
DB_NAME=stockflow